# Configuracoes do Servidor
PORT=3000
NODE_ENV=development

# Conexao PostgreSQL (Pode usar DATABASE_URL ou variaveis individuais)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/puroluxo_db
PGUSER=postgres
PGPASSWORD=postgrespassword
PGHOST=localhost
PGPORT=5432
PGDATABASE=puroluxo_db

# Segredos de Sessao e Criptografia (AES-256-GCM)
SESSION_SECRET=puro_luxo_grife_super_secret_session_key_2026
ENCRYPTION_SECRET=puroluxo_aes256_encryption_master_key_secret_2026

# Credenciais Iniciais do Administrador
ADMIN_DEFAULT_EMAIL=admin@puroluxo.com
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_NAME=Administrador Puro Luxo
